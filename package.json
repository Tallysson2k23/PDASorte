{
  "name": "sorteios-da-turma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --project pdssorte --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "emulators": "firebase emulators:start --project pdssorte",
    "bootstrap:superadmin": "node --env-file=.env.local scripts/bootstrap-superadmin.mjs"
  },
  "dependencies": {
    "file-type": "^22.0.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
